{gather_release_evidence()}

<!-- op: backlink-shipped-issues -->
{backlink_shipped_issues()}

<!-- op: ensure-traceable-issue -->
{ensure_traceable_issue()}

<!-- op: post-wave-report -->
{post_wave_report()}

<!-- op: ensure-pr-ready -->
{ensure_pr_ready()}
