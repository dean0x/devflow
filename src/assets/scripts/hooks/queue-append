#!/bin/bash
# queue-append -- shared queue-append helper (sourced, not executed).
#
# Single implementation of: umask-077 file creation, JSONL emit (jq --arg / node
# JSON.stringify -- never string concatenation), and 200->100 overflow truncation
# under a lock. Used by capture-prompt, capture-turn, and capture-question so the
# per-feature dual-queue-append logic exists in exactly one place.
#
# Source-order requirement: source json-parse (for _HAS_JQ) and learning-lock (for
# learning_lock_acquire/learning_lock_release, which itself requires get-mtime) BEFORE
# calling queue_append_row or queue_append_both. Sourcing this file itself only
# defines functions -- no side effects until they are called.
#
# queue_append_row <queue_file> <role> <content> <ts>
#   Appends one JSONL row {role, content, ts} to <queue_file>. Creates the file
#   with mode 0600 (umask 077) if absent. After appending, truncates from 200 to
#   the newest 100 lines under a lock (learning_lock_acquire on "<queue_file>.lock",
#   2s timeout). The append itself is intentionally lock-free (accepted-class
#   race shared with the pre-existing memory design -- see the design doc's
#   "Append-vs-claim race" note).
#
# queue_append_both <memory_queue> <learning_queue> <memory_enabled> <learning_enabled> <role> <content> <ts>
#   Calls queue_append_row for each queue whose *_enabled flag is "true". Each
#   queue is gated independently -- callers compute memory_enabled/learning_enabled
#   themselves (see queue_read_gates below for the at-most-one-fork read of both).
#
# queue_read_gates <manifest_path>
#   Reads BOTH `features.memory` and `features.learning` from the devflow-global
#   ~/.devflow/manifest.json in at most ONE subprocess fork (AC-P1 -- at most one
#   gate-read fork per capture hook, not two; none when D-GATES-FAST-PATH
#   settles it). Sets _QG_MEMORY and _QG_LEARNING ("true"/"false") in the
#   caller's scope. The two values are newline-separated
#   rather than using a control-character delimiter: they are always the literal
#   strings "true"/"false", never arbitrary content, so a plain newline split is
#   unambiguous and easy to review (no invisible bytes hiding in the source).
#
#   D-FEATURES-MACHINE-WIDE (src/core/feature-switch.ts): memory and learning are
#   switched for the WHOLE MACHINE by the manifest alone -- `devflow init` and
#   `devflow memory|learning --enable/--disable` both write it -- so the answer is
#   the same in every repo and every non-git cwd. The per-repo
#   .devflow/config.json is never read here: its old memory/learning keys are
#   retired, and reading them is what let a feature keep running in every repo
#   but the one `init --no-<feature>` ran in (#378). Only an explicit boolean
#   `false` switches a feature off -- an absent, unreadable or malformed manifest,
#   a missing key, or a non-boolean value leaves it ON (fail-open, ADR-028), the
#   same rule isMachineFeatureOn() applies in the CLI.
#
#   D-LEARNING-LEGACY-DECISIONS: learning reads `features.learning` when it is a
#   boolean, else the pre-rename `features.decisions` (ADR-011) -- readManifest's
#   migration precedence exactly, so a legacy `decisions: false` switches
#   learning off before any command has healed the file. Only a boolean `false`
#   in whichever key decides is off, as above.
#
#   Every hook that gates on memory or learning reads it through here: the
#   capture hooks, session-start-context (Sections 1-2), memory-worker,
#   session-start-memory, pre-compact-memory and background-memory-update. The
#   callers resolve <manifest_path> from ${DEVFLOW_DIR:-$HOME/.devflow} BEFORE
#   they shadow DEVFLOW_DIR with the project-scoped .devflow (memory-worker hands
#   its resolved path to the background worker it spawns).

queue_append_row() {
  local _qar_file="$1" _qar_role="$2" _qar_content="$3" _qar_ts="$4"

  if [ ! -f "$_qar_file" ]; then
    (umask 077 && touch "$_qar_file") 2>/dev/null || true
  fi

  if [ "$_HAS_JQ" = "true" ]; then
    jq -n -c --arg role "$_qar_role" --arg content "$_qar_content" --argjson ts "$_qar_ts" \
      '{role: $role, content: $content, ts: $ts}' >> "$_qar_file"
  else
    node -e "process.stdout.write(JSON.stringify({role:process.argv[1],content:process.argv[2],ts:parseInt(process.argv[3])})+String.fromCharCode(10))" \
      -- "$_qar_role" "$_qar_content" "$_qar_ts" >> "$_qar_file"
  fi

  # Overflow safety: >200 lines -> keep newest 100, locked to prevent a multi-session race.
  if [ -f "$_qar_file" ]; then
    local _qar_lines
    _qar_lines=$(wc -l < "$_qar_file" | tr -d ' ')
    if [ "$_qar_lines" -gt 200 ]; then
      local _qar_lock="${_qar_file}.lock"
      if learning_lock_acquire "$_qar_lock" 2; then
        _qar_lines=$(wc -l < "$_qar_file" | tr -d ' ')
        if [ "$_qar_lines" -gt 200 ]; then
          local _qar_tmp="${_qar_file}.tmp.$$"
          tail -100 "$_qar_file" > "$_qar_tmp" && mv "$_qar_tmp" "$_qar_file" || rm -f "$_qar_tmp"
          log "Queue overflow: truncated from $_qar_lines to 100 lines ($(basename "$_qar_file"))"
          dbg "Queue overflow: truncated from $_qar_lines to 100 lines ($_qar_file)"
        fi
        learning_lock_release "$_qar_lock"
      fi
    fi
  fi
}

queue_append_both() {
  local _qab_memory_queue="$1" _qab_learning_queue="$2"
  local _qab_memory_enabled="$3" _qab_learning_enabled="$4"
  local _qab_role="$5" _qab_content="$6" _qab_ts="$7"

  if [ "$_qab_memory_enabled" = "true" ]; then
    queue_append_row "$_qab_memory_queue" "$_qab_role" "$_qab_content" "$_qab_ts"
  fi
  if [ "$_qab_learning_enabled" = "true" ]; then
    queue_append_row "$_qab_learning_queue" "$_qab_role" "$_qab_content" "$_qab_ts"
  fi
}

queue_read_gates() {
  local _qg_manifest="${1:-}" _qg_text="" _qg_parse="false"
  _QG_MEMORY="true"
  _QG_LEARNING="true"

  if [ -n "$_qg_manifest" ] && [ -f "$_qg_manifest" ]; then
    # D-GATES-FAST-PATH: every capture hook and every session start pays this
    # read, and on most machines both switches are on. Only a JSON boolean
    # `false` under a "memory", "learning" or "decisions" key can switch anything
    # off, and a `\u` escape is the only JSON spelling of a letter other than the
    # letter itself, so without one such a key appears literally. A text holding
    # no `\u` and no key-then-`false` sequence therefore cannot switch anything
    # off -- valid or not, it reads both-on either way -- and is settled by shell
    # builtins (read, case, [[ =~ ]]) with no jq/node fork; everything else takes
    # the full parse below. `read -d ''` succeeds only on reaching a NUL byte,
    # i.e. before the end of the file, so a text it cut short is parsed in full
    # too. An unreadable file reads empty and fails open, as the parser would.
    local _qg_re='"(memory|learning|decisions)"[[:space:]]*:[[:space:]]*false'
    IFS= read -r -d '' _qg_text 2>/dev/null < "$_qg_manifest" && _qg_parse="true"
    case "$_qg_text" in *'\u'*) _qg_parse="true" ;; esac
    if [[ $_qg_text =~ $_qg_re ]]; then _qg_parse="true"; fi
  fi

  if [ "$_qg_parse" = "true" ]; then
    local _qg_fields
    if [ "$_HAS_JQ" = "true" ]; then
      # `try` covers a manifest whose top level or `features` is not an object; a
      # parse failure empties the output, which reads as "not switched off". The
      # comma produces two raw-output lines (newline-separated) in one jq process.
      _qg_fields=$(jq -r '
        (if (try .features.memory catch null) == false then "false" else "true" end),
        (if (try (.features | if (.learning | type) == "boolean" then .learning else .decisions end) catch null) == false
          then "false" else "true" end)
      ' "$_qg_manifest" 2>/dev/null) || _qg_fields=""
    else
      _qg_fields=$(node -e "
        const m = JSON.parse(require('fs').readFileSync(process.argv[1], 'utf8'));
        const f = m !== null && typeof m === 'object' ? m.features : undefined;
        const isObj = f !== null && typeof f === 'object';
        const on = (k) => !(isObj && f[k] === false);
        const learnKey = isObj && typeof f.learning !== 'boolean' ? 'decisions' : 'learning';
        process.stdout.write(String(on('memory')) + String.fromCharCode(10) + String(on(learnKey)));
      " -- "$_qg_manifest" 2>/dev/null) || _qg_fields=""
    fi
    if [ -n "$_qg_fields" ]; then
      _QG_MEMORY="${_qg_fields%%$'\n'*}"
      _QG_LEARNING="${_qg_fields#*$'\n'}"
    fi
  fi

  # Explicit return: this function's meaning is "populate _QG_* outputs," not a
  # success/failure signal, so its exit status must never leak the truthiness of
  # the last internal test into a `set -e` caller that invokes this function as
  # a plain statement.
  return 0
}
