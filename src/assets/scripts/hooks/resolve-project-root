#!/bin/bash
# resolve-project-root — anchor .devflow/ resolution to the project root.
#
# Hooks compute their .devflow/ path from the session/worker CWD. When a worker
# is spawned with a CWD deep inside the project — e.g. inside
# .devflow/docs/<...>/tickets/ — computing "$CWD/.devflow" there scaffolds a
# STRAY nested .devflow/. This helper resolves any CWD back to the real project
# root, mirroring the TS CLI's getGitRoot() (src/core/git.ts) so the shell
# side anchors identically.
#
# Sourced by: the memory/learning/session hooks and ensure-devflow-init.
# Sourced helper: uses `return`-free pure functions; _-prefixed locals (never
# clobbers caller vars). Safe under `set -e` (git failure is guarded with || true).
#
# Usage:
#   source resolve-project-root
#   PROJECT_ROOT="$(df_resolve_root "$CWD")"      # one root
#   df_resolve_roots "$CWD"                        # sets DF_ROOT and DF_LEDGER_ROOT
#
# df_resolve_root <cwd> prints the project root for <cwd>:
#   1. git top-level — git walks up to the real repo root even from a
#      .devflow/-nested subdir, so the nested case is fixed for git repos.
#   2. non-git fallback — strip from the first /.devflow/ onward (or a trailing
#      /.devflow), else print <cwd> unchanged.
df_resolve_root() {
  local _cwd="$1" _root=""
  # || true: under `set -e`, a failing command substitution would otherwise abort
  # the caller (e.g. a non-git path). Empty output then routes to the fallback.
  _root="$(git -C "$_cwd" rev-parse --show-toplevel 2>/dev/null || true)"
  if [ -z "$_root" ]; then
    case "$_cwd" in
      */.devflow/*) _root="${_cwd%%/.devflow/*}" ;;
      */.devflow)   _root="${_cwd%/.devflow}" ;;
      *)            _root="$_cwd" ;;
    esac
  fi
  printf '%s\n' "$_root"
}

# df_resolve_roots <cwd> sets TWO roots in the caller's scope, from ONE git call:
#   DF_ROOT        — the checkout's toplevel: where per-checkout data lives
#                    (memory, the .gitignore carve-out, the knowledge bases).
#   DF_LEDGER_ROOT — where the learning ledger and its queue live.
#
# D-LEDGER-MAIN-WORKTREE: a linked worktree (`git worktree add`, `claude
# --worktree`) has its own toplevel, so a ledger anchored there restarts at
# ADR-001 — main's decisions are invisible in it, and the IDs it mints collide
# with main's (in a repo whose collision guard refuses, the Learning agent stops
# for good). The ledger is one per REPOSITORY, not per checkout: DF_LEDGER_ROOT
# is the main worktree — the parent of `--git-common-dir` — when that common dir
# is a `<dir>/.git` directory AND `<dir>/.devflow` already exists; otherwise it is
# DF_ROOT. The existence test keeps a main checkout that never ran devflow from
# being scaffolded by a worktree session, and a common dir that is not `/.git`
# (a bare repository, `--separate-git-dir`, a submodule's modules/ dir) has no
# main checkout to name, so it stays per checkout. Memory stays at DF_ROOT on
# purpose: working memory describes the branch in front of you. A worktree that
# already grew its own ledger before this rule keeps it — local data is left in
# place, and the worktree simply stops appending to it.
#
# The one call asks for both answers at once:
#   git rev-parse --path-format=absolute --show-toplevel --git-common-dir
# and its output is accepted only when it is EXACTLY two lines, each an absolute
# path. `--path-format` arrived in git 2.31; an older git echoes the unknown
# flag back as a line of its own (three lines, the first not absolute), and a
# failed call prints nothing — both fall back to df_resolve_root, so the ledger
# stays at the toplevel exactly as before this rule. Parsing is parameter
# expansion and `case` only: no second subprocess on the success path.
df_resolve_roots() {
  local _cwd="$1" _out="" _top="" _common="" _main=""
  DF_ROOT=""
  DF_LEDGER_ROOT=""
  _out="$(git -C "$_cwd" rev-parse --path-format=absolute --show-toplevel --git-common-dir 2>/dev/null || true)"
  _top="${_out%%$'\n'*}"
  if [ "$_top" != "$_out" ]; then
    _common="${_out#*$'\n'}"
  fi
  case "$_top" in /*) ;; *) _top="" ;; esac
  case "$_common" in
    *$'\n'*) _common="" ;;
    /*) ;;
    *) _common="" ;;
  esac
  if [ -z "$_top" ] || [ -z "$_common" ]; then
    DF_ROOT="$(df_resolve_root "$_cwd")"
    [ -n "$DF_ROOT" ] || DF_ROOT="$_cwd"
    DF_LEDGER_ROOT="$DF_ROOT"
    return 0
  fi
  DF_ROOT="$_top"
  DF_LEDGER_ROOT="$_top"
  case "$_common" in
    */.git)
      _main="${_common%/.git}"
      if [ -n "$_main" ] && [ -d "$_main/.devflow" ]; then
        DF_LEDGER_ROOT="$_main"
      fi
      ;;
  esac
  return 0
}
