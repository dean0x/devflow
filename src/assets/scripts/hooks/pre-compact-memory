#!/bin/bash

# Working Memory: PreCompact Hook
# Safety net that captures git state to a backup JSON file before context compaction.
# Also bootstraps a minimal WORKING-MEMORY.md if none exists yet, so SessionStart
# has something to inject after compaction.
# PreCompact hooks cannot block compaction — this is informational only.
# Paths: .devflow/memory/backup.json, .devflow/memory/WORKING-MEMORY.md

# Safe no-op fallback: must exist before set -e and before hook-bootstrap is sourced.
dbg() { :; }

set -e

# Re-entrancy guard — before hook-bootstrap to minimize background session
# overhead. The memory worker's own claude -p session fires hooks too
# (PreCompact can fire mid-session on a long-running detached worker).
if [ "${DEVFLOW_BG_UPDATER:-}" = "1" ]; then dbg "EXIT: bg_updater"; exit 0; fi

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

source "$SCRIPT_DIR/hook-bootstrap" "pre-compact-memory"

# JSON parsing (jq with node fallback) — silently no-op if neither available
source "$SCRIPT_DIR/json-parse" || { echo "pre-compact-memory: failed to source json-parse" >&2; exit 1; }
source "$SCRIPT_DIR/is-hex-sha" || { echo "pre-compact-memory: failed to source is-hex-sha" >&2; exit 1; }
if [ "$_JSON_AVAILABLE" = "false" ]; then exit 0; fi

INPUT=$(cat)

CWD=$(printf '%s' "$INPUT" | json_field "cwd" "")
if [ -z "$CWD" ] || [ ! -d "$CWD" ]; then
  dbg "EXIT: bad CWD"
  exit 0
fi

devflow_debug_set_cwd "$CWD"
dbg "CWD=$CWD"

# Anchor .devflow/ to the project root (prevents a stray nested .devflow/ when this
# hook runs with a CWD inside .devflow/...). Empty → fall back to CWD.
source "$SCRIPT_DIR/resolve-project-root" 2>/dev/null || true
PROJECT_ROOT="$(df_resolve_root "$CWD" 2>/dev/null || true)"
[ -n "$PROJECT_ROOT" ] || PROJECT_ROOT="$CWD"

# The machine-wide manifest (the memory switch, D-FEATURES-NARROW-ONLY in
# queue-append) lives at the machine root,
# $HOME/.devflow (D-ONE-HOME).
DEVFLOW_MANIFEST="$HOME/.devflow/manifest.json"
PROJECT_DEVFLOW_DIR="$PROJECT_ROOT/.devflow"
MEMORY_DIR="$PROJECT_DEVFLOW_DIR/memory"

# Normal logging
source "$SCRIPT_DIR/hook-log-init" "pre-compact-memory"

# Memory gate: the machine switch, narrowed by this checkout's project.json /
# config.json `features.memory`, read by the helper every memory/learning gate
# shares (D-FEATURES-NARROW-ONLY, see queue-append).
source "$SCRIPT_DIR/queue-append" || { echo "pre-compact-memory: failed to source queue-append" >&2; exit 1; }
queue_read_gates "$DEVFLOW_MANIFEST" "$PROJECT_ROOT"
if [ "$_QG_MEMORY" != "true" ]; then
  dbg "EXIT: memory disabled"
  exit 0
fi

# Auto-create .devflow/ and ensure .gitignore entries (idempotent after first run)
source "$SCRIPT_DIR/ensure-devflow-init" "$CWD" || exit 0

BACKUP_FILE="$MEMORY_DIR/backup.json"

# Capture git state
GIT_HEAD_SHA=""
GIT_BRANCH=""
GIT_STATUS=""
GIT_LOG=""
GIT_DIFF_STAT=""
TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

if cd "$CWD" 2>/dev/null && git rev-parse --git-dir >/dev/null 2>&1; then
  GIT_HEAD_SHA=$(git rev-parse HEAD 2>/dev/null || echo "")
  GIT_BRANCH=$(git branch --show-current 2>/dev/null || echo "unknown")
  # D-DETACHED-HEAD: a checkout of a commit rather than a branch (`git checkout
  # <sha>`, bisect, a rebase stop, `git worktree add --detach`, a CI checkout)
  # prints no branch name. It is labelled `(detached)`, echoing git's own
  # `(HEAD detached at …)` display and holding no space, so the stamp's
  # one-token `branch:` field still parses; the backup names it and the bootstrap
  # below still stamps memory, keyed on the commit it describes. (A branch really
  # named `(detached)` is legal git and would read the same — accepted: nothing
  # decides on the label, it only names.) An unborn branch has no HEAD commit,
  # keeps the empty label, and is still skipped.
  if [ -z "$GIT_BRANCH" ] && is_hex_sha "$GIT_HEAD_SHA" 40 40; then
    GIT_BRANCH="(detached)"
  fi
  # D-NO-FSMONITOR: `status` and `diff` read the index, and reading the index
  # runs the command the repository's config names in `core.fsmonitor` — code
  # chosen by the repository this hook runs inside. Each index read turns it
  # off for itself (`-c core.fsmonitor=false`); rev-parse, branch and log never
  # read the index.
  GIT_STATUS=$(git -c core.fsmonitor=false status --porcelain 2>/dev/null | head -30 || echo "")
  GIT_LOG=$(git log --oneline -10 2>/dev/null || echo "")
  GIT_DIFF_STAT=$(git -c core.fsmonitor=false diff --stat HEAD 2>/dev/null || echo "")
  dbg "GIT_BRANCH=$GIT_BRANCH HEAD=$GIT_HEAD_SHA"
fi

# Snapshot current WORKING-MEMORY.md (preserves session context through compaction)
MEMORY_SNAPSHOT=""
if [ -f "$MEMORY_DIR/WORKING-MEMORY.md" ]; then
  MEMORY_SNAPSHOT=$(head -c 65536 "$MEMORY_DIR/WORKING-MEMORY.md")
  dbg "MEMORY_SNAPSHOT_LENGTH=${#MEMORY_SNAPSHOT}"
fi

# Write backup JSON
json_backup_construct \
  --arg ts "$TIMESTAMP" \
  --arg branch "$GIT_BRANCH" \
  --arg status "$GIT_STATUS" \
  --arg log "$GIT_LOG" \
  --arg diff "$GIT_DIFF_STAT" \
  --arg memory "$MEMORY_SNAPSHOT" \
  > "$BACKUP_FILE"

log "Wrote backup: $BACKUP_FILE"
dbg "Wrote backup: $BACKUP_FILE"

# Bootstrap minimal WORKING-MEMORY.md if absent; skip on an unborn branch or a
# malformed SHA. is_hex_sha 40 40: exactly 40 lowercase hex chars required. A detached
# HEAD bootstraps with a `branch: (detached)` stamp (D-DETACHED-HEAD, above): the
# stamp's memory-head SHA is what drift detection keys on, and the Context line names
# the commit by its short SHA, so the first compaction there no longer leaves the
# session with nothing to restore.
# avoids REL-5: O_EXCL-style atomic create via noclobber so the existence test and the
# create are one operation — if the worker's CAS mv lands in the window, noclobber fails
# (file already exists) and we skip the bootstrap rather than truncating fresh memory.
MEMORY_FILE="$MEMORY_DIR/WORKING-MEMORY.md"
if [ -n "$GIT_BRANCH" ] && is_hex_sha "$GIT_HEAD_SHA" 40 40; then
  if (set -o noclobber; : > "$MEMORY_FILE") 2>/dev/null; then
    {
      echo "<!-- memory-head: $GIT_HEAD_SHA branch: $GIT_BRANCH -->"
      echo ""
      echo "## Now"
      echo "- Session compacted before working memory was established"
      echo ""
      echo "## Progress"
      echo "- (no history yet)"
      echo ""
      echo "## Decisions"
      echo "- (none recorded)"
      echo ""
      echo "## Context"
      if [ "$GIT_BRANCH" = "(detached)" ]; then
        echo "- Branch: (detached) @ ${GIT_HEAD_SHA:0:7}"
      else
        echo "- Branch: $GIT_BRANCH"
      fi
      echo "$GIT_LOG" | head -3 | while IFS= read -r line; do
        [ -n "$line" ] && echo "- $line"
      done
      if [ -n "$GIT_STATUS" ]; then
        echo "- Modified files:"
        echo "$GIT_STATUS" | head -10 | while IFS= read -r line; do
          [ -n "$line" ] && echo "  - $(echo "$line" | awk '{print $2}')"
        done
      fi
      echo ""
      echo "## Session Log"
      echo "- (no entries)"
    } >> "$MEMORY_FILE"
    dbg "Bootstrapped minimal WORKING-MEMORY.md with stamp and canonical sections"
  fi
fi

log "PreCompact complete"
dbg "=== HOOK COMPLETE ==="
