#!/bin/bash
# Ensures .devflow/ and all subdirectories exist and the project root .gitignore
# ignores .devflow/. Called from capture-prompt, capture-turn, capture-question,
# memory-worker, and pre-compact-memory. Idempotent.
# Returns non-zero, having written nothing, outside a git project, at HOME, or when
# .devflow is a symbolic link.
# Usage: source ensure-devflow-init "$CWD"

[ -z "$1" ] && return 1

# Anchor to the project root so a CWD nested inside .devflow/ never scaffolds a
# stray nested .devflow/. Resolve our own dir via BASH_SOURCE (works whether sourced
# by a hook or directly by tests). Empty → fall back to "$1" (old behavior).
_EDI_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$_EDI_DIR/resolve-project-root" 2>/dev/null || true
df_resolve_roots "$1" 2>/dev/null || true
_EDI_ROOT="${DF_ROOT:-$1}"
_EDI_LEDGER="${DF_LEDGER_ROOT:-$_EDI_ROOT}"

# D-HOOKS-GIT-ONLY (git-marker): scaffold nothing outside a git project, and
# nothing at a repository rooted at HOME. D-HOOKS-TOPLEVEL-ONLY (git-marker): nor
# below a checkout's toplevel — when git refuses the cwd (dubious ownership,
# GIT_CEILING_DIRECTORIES) the root above is that cwd, and a subdirectory holds no
# `.git` of its own, so it is refused rather than scaffolded. This is the one gate every capture and
# memory caller (capture-prompt, capture-turn, capture-question, memory-worker,
# pre-compact-memory) passes through before it writes, and each of them treats a
# non-zero return as "stop" (`|| exit 0`), so memory and learning stop together
# in a non-git directory. ensure-root-gitignore itself stays ungated: it is a
# pure writer its parity suite runs in plain directories, and both of
# its callers now decide before reaching it. A helper that failed to source is a
# command not found — the refusing branch, so the failure mode writes nothing.
source "$_EDI_DIR/git-marker" 2>/dev/null || true
df_is_project_root "$_EDI_ROOT" 2>/dev/null || return 1

_DEVFLOW_DIR="$_EDI_ROOT/.devflow"

# D-HOOKS-NO-SYMLINK-WRITE (git-marker): a `.devflow` that is itself a symbolic link
# would take every folder below and the carve-out marker into the folder it names,
# so nothing is written and the caller stops, as at any root it may not write to.
# The skip is logged once, through log() where the caller defines it. A folder below
# `.devflow` that is a link is left to the write under it: `mkdir -p` creates
# nothing through a link it ends at.
if ! df_no_symlink_below "$_EDI_ROOT" "$_DEVFLOW_DIR"; then
  declare -F log >/dev/null 2>&1 && log "Skipped: $_DEVFLOW_DIR is a symbolic link; nothing written under it"
  return 1
fi

# learning/ is scaffolded only where the ledger lives. In a linked worktree whose
# main checkout holds the ledger (D-LEDGER-MAIN-WORKTREE, resolve-project-root) a
# learning/ here would be an empty directory nothing writes to; the capture hooks
# create the ledger's own learning/ at the ledger root when they append to it.
_EDI_LEARNING="$_DEVFLOW_DIR/learning"
[ "$_EDI_LEDGER" = "$_EDI_ROOT" ] || _EDI_LEARNING=""

# Fast-path: if all subdirectories already exist, skip mkdir and gitignore setup.
# The marker is the CURRENT carve-out version (D-GITIGNORE-V6), bumped with both
# writers' stamps, so a v5-stamped project misses this once and gains the
# `!.devflow/project.json` line.
if [ -d "$_DEVFLOW_DIR/memory" ] && [ -d "$_DEVFLOW_DIR/docs" ] && \
   { [ -z "$_EDI_LEARNING" ] || [ -d "$_EDI_LEARNING" ]; } && \
   [ -d "$_DEVFLOW_DIR/features" ] && \
   [ -f "$_DEVFLOW_DIR/.root-gitignore-configured-v6" ]; then
  return 0
fi

# Create all subdirectories
mkdir -p \
  "$_DEVFLOW_DIR/memory" \
  ${_EDI_LEARNING:+"$_EDI_LEARNING"} \
  "$_DEVFLOW_DIR/features" \
  "$_DEVFLOW_DIR/docs" \
  2>/dev/null || return 1

# One-time root .gitignore setup — delegated to the sibling ensure-root-gitignore
# helper (single source of truth) so the always-on, memory-independent
# session-start-context hook applies the identical rule. _EDI_DIR and _EDI_ROOT
# were resolved at the top of this script.
source "$_EDI_DIR/ensure-root-gitignore" "$_EDI_ROOT"
