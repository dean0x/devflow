#!/bin/bash
# Ensures .devflow/ and all subdirectories exist and the project root .gitignore
# ignores .devflow/. Called from capture-prompt, capture-turn, capture-question,
# memory-worker, and pre-compact-memory. Idempotent.
# Returns non-zero, having written nothing, outside a git project, at HOME, or when
# .devflow is a symbolic link. Also non-zero when it is given no root, when the ledger
# folder check fails (df_ledger_folder), and when the scaffold folders cannot be made.
# A missing curation-move shim is no failure: the ledger folder step is skipped.
# Usage: source ensure-devflow-init "$CWD"

[ -z "$1" ] && return 1

# Anchor to the project root so a CWD nested inside .devflow/ never scaffolds a
# stray nested .devflow/. Resolve our own dir via BASH_SOURCE (works whether sourced
# by a hook or directly by tests). Empty → fall back to "$1" (old behavior).
_EDI_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$_EDI_DIR/resolve-project-root" 2>/dev/null || true
df_resolve_roots "$1" 2>/dev/null || true
_EDI_ROOT="${DF_ROOT:-$1}"
_EDI_LEDGER="${DF_LEDGER_ROOT:-$_EDI_ROOT}"

# D-HOOKS-GIT-ONLY (git-marker): scaffold nothing outside a git project, and
# nothing at a repository rooted at HOME. D-HOOKS-TOPLEVEL-ONLY (git-marker): nor
# below a checkout's toplevel — when git refuses the cwd (dubious ownership,
# GIT_CEILING_DIRECTORIES) the root above is that cwd, and a subdirectory holds no
# `.git` of its own, so it is refused rather than scaffolded. This is the one gate every capture and
# memory caller (capture-prompt, capture-turn, capture-question, memory-worker,
# pre-compact-memory) passes through before it writes, and each of them treats a
# non-zero return as "stop" (`|| exit 0`), so memory and curation stop together
# in a non-git directory. ensure-root-gitignore itself stays ungated: it is a
# pure writer its parity suite runs in plain directories, and both of
# its callers now decide before reaching it. A helper that is missing is a
# command not found — the refusing branch, so the failure mode writes nothing. Each
# source is guarded by a builtin readability test: bash 3.2 under `set -e` ends the
# shell at a `source` of a missing file, even inside `|| true`.
[ -r "$_EDI_DIR/git-marker" ] && source "$_EDI_DIR/git-marker" 2>/dev/null || true
df_is_project_root "$_EDI_ROOT" 2>/dev/null || return 1

_DEVFLOW_DIR="$_EDI_ROOT/.devflow"

# D-HOOKS-NO-SYMLINK (git-marker): a `.devflow` that is itself a symbolic link
# would take every folder below and the carve-out marker into the folder it names,
# so nothing is written and the caller stops, as at any root it may not write to.
# The skip is logged once, through log() where the caller defines it. A folder below
# `.devflow` that is a link is left to the write under it: `mkdir -p` creates
# nothing through a link it ends at.
if ! df_no_symlink_below "$_EDI_ROOT" "$_DEVFLOW_DIR"; then
  declare -F log >/dev/null 2>&1 && log "Skipped: $_DEVFLOW_DIR is a symbolic link; nothing written under it"
  return 1
fi

# The one-time move of the old learning/ ledger folder to curation/ (curation-move):
# before anything below reads or creates the ledger folder, on the LEDGER root (the
# main worktree's, in a linked worktree), and whether or not the curation switch is
# on. A move another process holds, or a refused one, leaves the old folder where it
# is; the creator rule below then takes the old folder as the ledger folder. A shim that
# is missing skips the move, and the ledger folder step below.
[ -r "$_EDI_DIR/curation-move" ] && source "$_EDI_DIR/curation-move" 2>/dev/null || true
df_curation_move "$_EDI_LEDGER" 2>/dev/null || true

# curation/ is scaffolded only where the ledger lives. In a linked worktree whose
# main checkout holds the ledger (D-LEDGER-MAIN-WORKTREE, resolve-project-root) a
# curation/ here would be an empty directory nothing writes to; the capture hooks
# create the ledger's own curation/ at the ledger root when they append to it.
# The creator rule (git-marker, df_make_ledger_folder): the folder made is the new one
# only when the old name is absent, so a new folder never hides an old ledger, and a
# creator never makes the old folder. The names come from the move shim
# (df_curation_move_names), the one shell place that holds them. Either name satisfies
# the fast path below, so a root whose old folder is still there (held, refused or not
# yet tried) forks no mkdir.
# Without the shim there are no names, and this step has no ledger folder to check or
# make: the rest of the scaffold goes on.
_EDI_CURATION=""
if df_curation_move_names 2>/dev/null; then
  df_ledger_folder "$_DEVFLOW_DIR" "$DF_CM_OLD_FOLDER" "$DF_CM_NEW_FOLDER" || return 1
  _EDI_CURATION="$DF_LEDGER_FOLDER"
  [ "$_EDI_LEDGER" = "$_EDI_ROOT" ] || _EDI_CURATION=""
fi

# Fast-path: if all subdirectories already exist, skip mkdir and gitignore setup.
# The marker is the CURRENT carve-out version (D-GITIGNORE-V6), bumped with both
# writers' stamps, so a v5-stamped project misses this once and gains the
# `!.devflow/project.json` line.
if [ -d "$_DEVFLOW_DIR/memory" ] && [ -d "$_DEVFLOW_DIR/docs" ] && \
   { [ -z "$_EDI_CURATION" ] || [ -d "$_EDI_CURATION" ]; } && \
   [ -d "$_DEVFLOW_DIR/features" ] && \
   [ -f "$_DEVFLOW_DIR/.root-gitignore-configured-v6" ]; then
  return 0
fi

# Create all subdirectories. The ledger folder is made by its own guarded creator, never
# by this mkdir: a probe that saw the old folder must not bring it back after a move.
mkdir -p \
  "$_DEVFLOW_DIR/memory" \
  "$_DEVFLOW_DIR/features" \
  "$_DEVFLOW_DIR/docs" \
  2>/dev/null || return 1

# A ledger folder that could not be made leaves the memory scaffold as it is, and the
# next event looks again. A link on its path makes the capture hooks refuse its queue;
# after a failed mkdir, the append makes the folder again, as its creator.
if [ -n "$_EDI_CURATION" ]; then
  df_make_ledger_folder "$_EDI_ROOT" "$_DEVFLOW_DIR" "$DF_CM_OLD_FOLDER" "$DF_CM_NEW_FOLDER" || true
fi

# One-time root .gitignore setup — delegated to the sibling ensure-root-gitignore
# helper (single source of truth) so the always-on, memory-independent
# session-start-context hook applies the identical rule. _EDI_DIR and _EDI_ROOT
# were resolved at the top of this script.
source "$_EDI_DIR/ensure-root-gitignore" "$_EDI_ROOT"
