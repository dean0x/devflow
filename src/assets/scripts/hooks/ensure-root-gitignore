#!/bin/bash
# ensure-root-gitignore — single source of truth for the project root .gitignore
# rules that govern .devflow/.
#
# .devflow/ holds per-developer runtime state (memory, learning, docs, locks) —
# local by default. FOUR exceptions are shared via git:
# 1. Feature knowledge bases under .devflow/features/: index.md and every
#    {slug}/KNOWLEDGE.md (tracked, committed by the Knowledge agent at workflow end).
# 2. .devflow/conventions.md — naming-convention authority written by the Git
#    learn-conventions operation; shared so the team uses one naming source.
# 3. .devflow/policy.json — the retired evidence-policy file: never parsed, but
#    where project.json has no `evidence` its presence holds the repository at
#    required (D-POLICY-JSON-RETIRED). Devflow never writes it.
# 4. .devflow/project.json — the team-committed settings both resolvers read
#    (D-GITIGNORE-V6). Devflow never writes it.
#
# Everything else under .devflow/ stays local. A user opts back out of the first two
# by re-adding `.devflow/features/` or `.devflow/conventions.md` to their own .gitignore.
#
# Re-including files under an ignored tree requires un-ignoring each level with a
# `dir/*` + `!dir/keep` pair: a bare `.devflow/` excludes the directory outright,
# so git never descends and later negations are dead. Hence the multi-line block.
#
# Sourced by:
#   - ensure-devflow-init (reached via the memory/learning hooks)
#   - session-start-context (always-on, memory-independent — covers memory-off
#     projects that still use learning/knowledge)
# Both reach this one writer so the rule is applied identically everywhere; this
# decouples git-tracking of .devflow/ from any single feature toggle.
#
# Idempotent and O(1) after the first run via the .root-gitignore-configured-v6
# marker under .devflow/ (project-local). The marker is a claim, not proof, so the
# fast path also requires the block's own sentinel, the policy line, the project
# line AND a .claudeignore entry to be present; a .gitignore that lost any of them (a
# merge resolution, a hand edit) is healed on the next run. A v5-marked project
# misses the fast path, gains the project line just before its .claudeignore line
# and is re-stamped v6 (D-GITIGNORE-V6); a v4-marked one gains the policy and
# project lines.
#
# D-GITIGNORE-IN-BLOCK: a line topped up into an existing block goes INSIDE the
# block, where a fresh block holds it, never at the end of the file. gitignore is
# last-match-wins, so a `!.devflow/project.json` appended after a user's own later
# `.devflow/project.json` would silently override their re-ignore. The missing
# lines are inserted as one run, in block order, right after the block sentinel
# and the block lines that precede the first missing one in a fresh block (at most
# three: the sentinel, the policy line, the project line). Every other byte of the
# file is kept.
#
# D-GITIGNORE-V5 / D-GITIGNORE-V6: the block is detected ONLY by its devflow-unique
# sentinel `!.devflow/conventions.md` — NEVER by `.claudeignore`,
# `!.devflow/policy.json` or `!.devflow/project.json`, which users legitimately author
# themselves. Those three are completion lines: each is topped up when missing, in
# block order (policy, project, then .claudeignore). Keying presence
# off a user-authored line inverts both halves of the contract: projects that already
# carry that line never receive the carve-out (so .devflow/ runtime files leak into
# git), and re-appending `.claudeignore` after a user's `!.claudeignore` reverses
# their intent under gitignore's last-match-wins. Hence: a `.claudeignore` OR
# `!.claudeignore` entry means "the user owns that line" — emit the block without it.
# All matching is whole-line and whitespace-tolerant; never substring.
#
# Usage: source ensure-root-gitignore "$PROJECT_ROOT"
# Sourced helper: uses `return` (never exit), _ERG_-prefixed locals (never clobbers
# caller vars).

[ -z "$1" ] && return 1

_ERG_DEVFLOW_DIR="$1/.devflow"
_ERG_MARKER="$_ERG_DEVFLOW_DIR/.root-gitignore-configured-v6"
_ERG_GITIGNORE="$1/.gitignore"

# Whole-line, whitespace-tolerant matchers. `*` and `.` are escaped so the ERE
# matches the literal gitignore patterns.
_ERG_RE_OPTOUT='^[[:space:]]*/\.devflow/[[:space:]]*$'
_ERG_RE_LEGACY='^[[:space:]]*\.devflow/[[:space:]]*$'
_ERG_RE_SENTINEL='^[[:space:]]*!\.devflow/conventions\.md[[:space:]]*$'
_ERG_RE_SENTINEL_V2='^[[:space:]]*!\.devflow/features/\*/KNOWLEDGE\.md[[:space:]]*$'
_ERG_RE_POLICY='^[[:space:]]*!\.devflow/policy\.json[[:space:]]*$'
_ERG_RE_PROJECT='^[[:space:]]*!\.devflow/project\.json[[:space:]]*$'
_ERG_RE_CLAUDEIGNORE='^[[:space:]]*!?\.claudeignore[[:space:]]*$'

# Drop every legacy marker beside v6 — builtin `[ -e ]` tests, so rm forks only for a
# marker that exists. Called from the fast path and from the on-success stamp below,
# so an older devflow's marker is dropped whichever path a run takes.
# Always returns 0 (never fails the caller under `set -e`): the last iteration's
# `[ -e ]` test is false whenever the unversioned marker is absent (the common case),
# and a function call's own exit status is NOT exempt from errexit the way an inlined
# for-loop's is — unlike this same loop when it sat directly inside the caller's `{ }`.
_erg_drop_legacy_markers() {
  for _ERG_OLD in -v5 -v4 -v3 -v2 ''; do
    [ -e "$_ERG_DEVFLOW_DIR/.root-gitignore-configured$_ERG_OLD" ] \
      && rm -f "$_ERG_DEVFLOW_DIR/.root-gitignore-configured$_ERG_OLD" 2>/dev/null
  done
  return 0
}

# Fast path: converged only when the marker is stamped AND the block sentinel is
# present AND the policy and project lines are present AND a .claudeignore entry
# exists. Every other state falls through and recomputes.
if [ -f "$_ERG_MARKER" ] \
  && grep -qE "$_ERG_RE_SENTINEL" "$_ERG_GITIGNORE" 2>/dev/null \
  && grep -qE "$_ERG_RE_POLICY" "$_ERG_GITIGNORE" 2>/dev/null \
  && grep -qE "$_ERG_RE_PROJECT" "$_ERG_GITIGNORE" 2>/dev/null \
  && grep -qE "$_ERG_RE_CLAUDEIGNORE" "$_ERG_GITIGNORE" 2>/dev/null; then
  _erg_drop_legacy_markers
  return 0
fi

# The marker lives under .devflow/, so the directory must exist before we touch it.
# (ensure-devflow-init creates it earlier; session-start-context may reach here first.)
mkdir -p "$_ERG_DEVFLOW_DIR" 2>/dev/null || return 1

# The carve-out block, built once. _ERG_BLOCK_NO_CI is the block a project that owns
# its own .claudeignore entry receives; _ERG_BLOCK is that plus the final line.
# Both trail a newline. Keep byte-identical to DEVFLOW_GITIGNORE_BLOCK and
# DEVFLOW_GITIGNORE_BLOCK_WITHOUT_CLAUDEIGNORE in
# src/targets/claude-code/post-install.ts.
printf -v _ERG_BLOCK_NO_CI '%s\n' \
  '# Devflow runtime data — local by default (memory, learning, docs, locks).' \
  '# Shared via git: feature knowledge bases under .devflow/features/ (index.md and' \
  '# every {slug}/KNOWLEDGE.md), .devflow/conventions.md (naming authority),' \
  '# .devflow/policy.json (retired; presence only) and .devflow/project.json (team settings).' \
  '# To stop sharing the first two, re-add `.devflow/features/` or' \
  '# `.devflow/conventions.md` to your own .gitignore.' \
  '.devflow/*' \
  '!.devflow/features/' \
  '.devflow/features/*' \
  '!.devflow/features/index.md' \
  '!.devflow/features/*/' \
  '.devflow/features/*/*' \
  '!.devflow/features/*/KNOWLEDGE.md' \
  '!.devflow/conventions.md' \
  '!.devflow/policy.json' \
  '!.devflow/project.json'
printf -v _ERG_LINE_SENTINEL '%s\n' '!.devflow/conventions.md'
printf -v _ERG_LINE_POLICY '%s\n' '!.devflow/policy.json'
printf -v _ERG_LINE_PROJECT '%s\n' '!.devflow/project.json'
printf -v _ERG_LINE_CLAUDEIGNORE '%s\n' '.claudeignore'
_ERG_BLOCK="$_ERG_BLOCK_NO_CI$_ERG_LINE_CLAUDEIGNORE"

# Does the file already carry the policy line, the project line, or a .claudeignore
# entry of the user's own (either form)? Computed BEFORE the legacy filter below,
# which rewrites the file.
_ERG_HAS_POLICY=0
grep -qE "$_ERG_RE_POLICY" "$_ERG_GITIGNORE" 2>/dev/null && _ERG_HAS_POLICY=1
_ERG_HAS_PROJECT=0
grep -qE "$_ERG_RE_PROJECT" "$_ERG_GITIGNORE" 2>/dev/null && _ERG_HAS_PROJECT=1
_ERG_HAS_CI=0
grep -qE "$_ERG_RE_CLAUDEIGNORE" "$_ERG_GITIGNORE" 2>/dev/null && _ERG_HAS_CI=1

# The completion lines this file lacks, in block order (policy, project, then
# .claudeignore). Mirrors missingCompletionLines in the TS twin.
_ERG_COMPLETION=''
if [ "$_ERG_HAS_POLICY" = 0 ]; then
  _ERG_COMPLETION="$_ERG_LINE_POLICY"
fi
if [ "$_ERG_HAS_PROJECT" = 0 ]; then
  _ERG_COMPLETION="$_ERG_COMPLETION$_ERG_LINE_PROJECT"
fi
if [ "$_ERG_HAS_CI" = 0 ]; then
  _ERG_COMPLETION="$_ERG_COMPLETION$_ERG_LINE_CLAUDEIGNORE"
fi

# The block lines a top-up run is inserted after: the sentinel, then whichever of
# the policy and project lines precede the first missing line in a fresh block.
# Mirrors blockRunBefore in the TS twin.
if [ "$_ERG_HAS_POLICY" = 0 ]; then
  _ERG_RUN_RE='^[[:space:]]*(!\.devflow/conventions\.md)[[:space:]]*$'
elif [ "$_ERG_HAS_PROJECT" = 0 ]; then
  _ERG_RUN_RE='^[[:space:]]*(!\.devflow/conventions\.md|!\.devflow/policy\.json)[[:space:]]*$'
else
  _ERG_RUN_RE='^[[:space:]]*(!\.devflow/conventions\.md|!\.devflow/policy\.json|!\.devflow/project\.json)[[:space:]]*$'
fi

# Classify: noop (nothing to do) | continue (extend an existing block) |
# block (install a fresh block) | fail (a rewrite failed; leave the file alone).
# continue inserts _ERG_APPEND after the first line matching _ERG_ANCHOR_RE and the
# run of lines matching _ERG_RUN_RE right after it (empty: no run).
_ERG_MODE=noop
_ERG_APPEND=''
_ERG_ANCHOR_RE=''
if grep -qE "$_ERG_RE_OPTOUT" "$_ERG_GITIGNORE" 2>/dev/null; then
  # User-authored `/.devflow/` (leading slash) — respect it; don't force the carve-out.
  # Checked FIRST so a file containing both it and a sentinel keeps the user's entry.
  _ERG_MODE=noop
elif grep -qE "$_ERG_RE_SENTINEL" "$_ERG_GITIGNORE" 2>/dev/null; then
  # Block installed (v3 and later) — top up only the completion lines it lacks.
  if [ -n "$_ERG_COMPLETION" ]; then
    _ERG_MODE=continue
    _ERG_APPEND="$_ERG_COMPLETION"
    _ERG_ANCHOR_RE="$_ERG_RE_SENTINEL"
  fi
elif grep -qE "$_ERG_RE_SENTINEL_V2" "$_ERG_GITIGNORE" 2>/dev/null; then
  # v2 block installed — insert the lines it lacks, in block order, right after
  # its sentinel, the last carve-out line it has.
  _ERG_MODE=continue
  _ERG_APPEND="$_ERG_LINE_SENTINEL$_ERG_COMPLETION"
  _ERG_ANCHOR_RE="$_ERG_RE_SENTINEL_V2"
  _ERG_RUN_RE=''
else
  # No devflow block — install one, omitting the .claudeignore line the user owns.
  _ERG_MODE=block
  if [ "$_ERG_HAS_CI" = 1 ]; then
    _ERG_APPEND="$_ERG_BLOCK_NO_CI"
  else
    _ERG_APPEND="$_ERG_BLOCK"
  fi
  if grep -qE "$_ERG_RE_LEGACY" "$_ERG_GITIGNORE" 2>/dev/null; then
    # Upgrade our legacy wholesale entry: strip the bare `.devflow/` line and our old
    # comment first, then fall through to the shared append below. Portable (grep
    # filter + mv; no sed -i, which differs on BSD/GNU).
    # The pipeline's own status is deliberately ignored: grep -v exits 1 when it
    # emits no lines, which is the correct outcome for a .gitignore whose only
    # content was the legacy entry. The redirect creates _ERG_TMP either way.
    _ERG_TMP="$_ERG_GITIGNORE.devflow-tmp.$$"
    grep -vE "$_ERG_RE_LEGACY" "$_ERG_GITIGNORE" 2>/dev/null \
      | grep -vF '# Devflow runtime data (local by default; remove to share via git)' \
      > "$_ERG_TMP" 2>/dev/null
    if [ -f "$_ERG_TMP" ] && mv "$_ERG_TMP" "$_ERG_GITIGNORE"; then
      :
    else
      rm -f "$_ERG_TMP" 2>/dev/null
      _ERG_MODE=fail
    fi
  fi
fi

# _erg_insert_in_block <anchor-ERE> <run-ERE or ''> <text> — rewrite the file with
# <text> inserted after the first line matching <anchor-ERE> and the run of up to
# three lines matching <run-ERE> right after it (D-GITIGNORE-IN-BLOCK). Mirrors
# insertInBlock in the TS twin byte for byte: head and tail copy every other byte
# unchanged, and when the run ends on a last line with no newline, one is added
# before <text>. Each read ends in a trailing `x`, so command substitution cannot
# strip the file's own trailing newlines. The file is rewritten in place with one
# `>`, as the TS twin's writeFile does, so a symlinked .gitignore keeps its link.
# Returns non-zero, having written nothing, when the anchor line cannot be found.
_erg_insert_in_block() {
  local _anchor="$1" _run="$2" _text="$3" _hit="" _n="" _next="" _line="" _i=0 _head="" _tail=""
  _hit="$(grep -n -m 1 -E "$_anchor" "$_ERG_GITIGNORE" 2>/dev/null)" || return 1
  _n="${_hit%%:*}"
  case "$_n" in ''|*[!0-9]*) return 1 ;; esac
  if [ -n "$_run" ]; then
    _next="$(sed -n "$((_n + 1)),$((_n + 3))p" "$_ERG_GITIGNORE" 2>/dev/null)"
    while [ "$_i" -lt 3 ] && [ -n "$_next" ]; do
      _line="${_next%%$'\n'*}"
      if [ "$_line" = "$_next" ]; then _next=''; else _next="${_next#*$'\n'}"; fi
      [[ $_line =~ $_run ]] || break
      _n=$((_n + 1))
      _i=$((_i + 1))
    done
  fi
  # The `x` is printed only when the read succeeded, so a failed read leaves none
  # and nothing is written — never a truncated file.
  _head="$(head -n "$_n" "$_ERG_GITIGNORE" 2>/dev/null && printf x)"
  case "$_head" in *x) _head="${_head%x}" ;; *) return 1 ;; esac
  _tail="$(tail -n "+$((_n + 1))" "$_ERG_GITIGNORE" 2>/dev/null && printf x)"
  case "$_tail" in *x) _tail="${_tail%x}" ;; *) return 1 ;; esac
  case "$_head" in *$'\n') ;; *) _head="$_head"$'\n' ;; esac
  printf '%s%s%s' "$_head" "$_text" "$_tail" > "$_ERG_GITIGNORE"
}

# The fresh-block append shape, mirrored byte-for-byte by the TS twin's appendBlock.
# `tail -c 1` yields the empty string when the file already ends in a newline
# (command substitution strips it), so a file whose last byte is not a newline gets
# one before the appended text fuses onto its last line. Existing trailing newlines
# are preserved verbatim — no trimming, no blank-line dedupe.
_ERG_OK=0
case "$_ERG_MODE" in
  noop)
    _ERG_OK=1
    ;;
  continue)
    _erg_insert_in_block "$_ERG_ANCHOR_RE" "$_ERG_RUN_RE" "$_ERG_APPEND" && _ERG_OK=1
    ;;
  block)
    if [ ! -s "$_ERG_GITIGNORE" ]; then
      # Absent or empty — the block is the whole file, with no leading blank line.
      printf '%s' "$_ERG_APPEND" > "$_ERG_GITIGNORE" && _ERG_OK=1
    else
      if [ -n "$(tail -c 1 "$_ERG_GITIGNORE" 2>/dev/null)" ]; then
        printf '\n' >> "$_ERG_GITIGNORE"
      fi
      { printf '\n'; printf '%s' "$_ERG_APPEND"; } >> "$_ERG_GITIGNORE" && _ERG_OK=1
    fi
    ;;
esac

# On success, stamp the current-format v6 marker and drop legacy markers. The marker
# is created only where nothing stands (noclobber), never `touch`ed: `touch` follows
# a symbolic link committed at its path (D-HOOKS-NO-SYMLINK, git-marker), and
# a marker already there is all the fast path needs. A `.devflow` that is itself a
# link is refused by both callers before they reach this file.
[ "$_ERG_OK" = 1 ] && {
  (set -o noclobber; : > "$_ERG_MARKER") 2>/dev/null || true
  _erg_drop_legacy_markers
}
return 0
