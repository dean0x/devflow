#!/bin/bash

# Devflow Preamble: UserPromptSubmit Hook
# Three behaviors (git repos only — silent outside a git tree):
#   1. Plan-handoff fast-path: if prompt begins `Implement the following plan:` (Claude Code's
#      native plan-mode handoff) AND devflow:implement is installed, inject a directive to invoke
#      devflow:implement immediately. devflow writes the file hooks/assets/implement-installed
#      while implement is installed and removes it otherwise; the hook only tests that the file
#      exists. Without it a handoff prompt falls through to the reminder (behavior 3).
#      NOTE: the literal prefix is duplicated in orchestrator-charter.md (plan-handoff bullet,
#      which the installed render drops when implement is absent) and in the dispatch below —
#      update both together if Claude Code changes the handoff format.
#   2. Slash skip: no reminder for slash commands (/...).
#   3. Orchestrator reminder (1 line): all other prompts, and a handoff prompt when implement
#      is not installed, get a generic delegation reminder.

# Safe no-op fallback: must exist before hook-bootstrap is sourced.
dbg() { :; }

# set -e intentionally omitted: guard clauses ensure fail-open exit 0 on all paths.

# Re-entrancy guard — before hook-bootstrap to minimize background session overhead.
# The memory worker's own claude -p session fires UserPromptSubmit; without this guard
# the nested background session would receive the orchestrator reminder (or, on a
# matching prompt, a plan-handoff directive) it must never act on. Mirrors the sibling
# capture-prompt UserPromptSubmit hook and session-start-orchestrator.
if [ "${DEVFLOW_BG_UPDATER:-}" = "1" ]; then dbg "EXIT: bg_updater"; exit 0; fi

# JSON parsing (jq with node fallback) — silently no-op if neither available
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

source "$SCRIPT_DIR/hook-bootstrap" "preamble"

source "$SCRIPT_DIR/json-parse" || { echo "preamble: failed to source json-parse" >&2; exit 1; }
if [ "$_JSON_AVAILABLE" = "false" ]; then exit 0; fi

INPUT=$(cat)

FIELDS=$(printf '%s' "$INPUT" | json_extract_cwd_prompt)
CWD="${FIELDS%%$'\001'*}"
PROMPT="${FIELDS#*$'\001'}"

dbg "PROMPT_LENGTH=${#PROMPT}"

if [ -z "$CWD" ] || [ ! -d "$CWD" ]; then
  dbg "EXIT: bad CWD"
  exit 0
fi

devflow_debug_set_cwd "$CWD"
dbg "CWD=$CWD"

# --- Git-repo gate (pure bash, bounded walk) ---
source "$SCRIPT_DIR/git-marker" || true
if ! df_has_git_marker "$CWD" 2>/dev/null; then dbg "EXIT: not a git repo"; exit 0; fi

# --- Prompt dispatch (pure bash 3.2; no subprocess in this block) ---
# The plan-handoff prefix is a Claude Code protocol marker (native "execute plan
# in new session" handoff), matched literally — plumbing, not semantic detection.
# Duplicated in orchestrator-charter.md (plan-handoff bullet); update both together.
# The handoff branch also needs the implement sentinel file: the directive names
# devflow:implement, so it fires only while that command is installed. The sentinel
# check is a builtin file test (no fork) and runs only after the prefix matched.
# Its path equals HANDOFF_SENTINEL_RELPATH in src/targets/claude-code/charter-render.ts
# (the hooks directory is SCRIPT_DIR); tests/shell-hooks.test.ts pins the match.
# Known bound: prefix must appear within the first 256 bytes after whitespace
# strip (native handoffs have zero leading whitespace).
HEAD="${PROMPT:0:256}"
HEAD="${HEAD#"${HEAD%%[![:space:]]*}"}"   # strip leading whitespace/newlines

if [ -z "$HEAD" ]; then
  dbg "EXIT: empty prompt"
elif [[ "$HEAD" == "Implement the following plan:"* ]] && [ -f "$SCRIPT_DIR/assets/implement-installed" ]; then
  dbg "PLAN_HANDOFF detected — injecting devflow:implement directive"
  # D-ARGS-ONCE: the directive passes the Skill call NO arguments. The handoff
  # prompt IS the plan, so it is already in the conversation; handing it to the
  # skill as an argument would put a second copy in the main-thread context for
  # nothing. The skill's empty-input path takes the plan from the conversation.
  # No plan body or plan path is parsed here: detection stays the literal prefix.
  # This string is double-quoted bash: it must hold no dollar sign and no
  # unescaped backtick, and it must equal HANDOFF_TEMPLATE in
  # tests/fixtures/ambient-templates.ts byte for byte.
  json_prompt_output "The user's prompt is a plan handoff (it begins with \`Implement the following plan:\`). In one short sentence, tell the user you're invoking \`devflow:implement\`. Then immediately invoke it with the Skill tool and no arguments: the plan is already in this conversation, so the skill needs no input. Do not pause to ask whether to proceed."
elif [[ "$HEAD" == "/"* ]]; then
  dbg "EXIT: slash command — no reminder"
else
  dbg "ORCHESTRATOR_REMINDER injected"
  json_prompt_output "Orchestrator reminder: coordinate, don't produce — delegate edits, builds and multi-file reads to a roster agent or a devflow workflow skill; keep only judgment work mainline."
fi

dbg "=== HOOK COMPLETE ==="
