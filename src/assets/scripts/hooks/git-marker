#!/bin/bash
# Sourced helper: df_has_git_marker <dir> — returns 0 if <dir> or any of its
# ancestors (bounded, max 64 levels) contains a .git entry (dir or file).
# Pure bash, no subprocess — safe for the per-prompt UserPromptSubmit hot path.
# The -e test covers both .git directories and worktree/submodule .git files.
df_has_git_marker() {
  local _dir="$1" _i=0
  while [ "$_i" -lt 64 ]; do
    [ -e "$_dir/.git" ] && return 0
    if [ "$_dir" = "/" ] || [ -z "$_dir" ]; then return 1; fi
    _dir="${_dir%/*}"
    [ -z "$_dir" ] && _dir="/"
    _i=$((_i + 1))
  done
  return 1
}

# df_is_project_root <root> — returns 0 when <root> may hold per-project devflow
# data: it is a checkout's toplevel — it holds its own `.git` entry — AND it is not
# the home directory.
#
# D-HOOKS-GIT-ONLY: the hooks that scaffold `.devflow/` and the root `.gitignore`
# carve-out — session-start-context and ensure-devflow-init, which every capture
# and memory hook reaches — run only for a git project. Outside one there is no
# repository for the carve-out to protect and no branch for memory to describe,
# and scaffolding there would leave `.devflow/` and a `.gitignore` block in `~`,
# Downloads or a folder of repos — wherever Claude Code happened to start.
# A repository rooted at HOME (a dotfiles repo) is refused too: its `.devflow` IS
# the machine root, so per-project data would land inside `~/.devflow` and its
# carve-out in the user's home `.gitignore`.
#
# D-HOOKS-TOPLEVEL-ONLY: the `.git` entry must sit AT <root>, not merely above it.
# Callers pass the root df_resolve_roots resolved, and when `git rev-parse` fails
# from inside a checkout — the repository has dubious ownership, or
# GIT_CEILING_DIRECTORIES stops git's search — that root is the raw cwd, possibly a
# subdirectory. An ancestor walk would still find the checkout's `.git` and admit
# it, and `.devflow/` plus a `.gitignore` block would land in that subdirectory.
# Requiring the marker at the root makes the gate and the resolver agree: git's
# toplevel always holds `.git` (a directory, or the file a linked worktree or
# submodule carries), a subdirectory never does. A directory that holds its own
# `.git` still passes when git cannot read it — the marker contract is the zero-fork
# one above, and writing there scatters nothing, because it is the checkout's root.
#
# The comparison is between PHYSICAL paths, because the two sides reach it by
# different routes: git reports a toplevel with every symlink resolved, while
# $HOME is whatever the login shell was handed — on macOS the temp tree is
# /var → /private/var, and a home directory can itself sit behind a symlink. A
# textual compare would miss exactly the case it exists for.
#
# Zero forks, like the marker walk above: a builtin `-e` test, then `cd -P`, which
# resolves a path physically and publishes it in $PWD — both shell builtins, so no
# `$(...)` subshell and no realpath/readlink binary is involved. The caller's directory is restored before
# returning. An unresolvable <root> is refused (fail closed: nothing is written);
# an unset or unresolvable HOME cannot equal a resolved root, so it refuses nothing.
df_is_project_root() {
  local _root="$1" _back="$PWD" _root_real="" _home_real=""
  [ -n "$_root" ] || return 1
  [ -e "$_root/.git" ] || return 1
  if cd -P "$_root" 2>/dev/null; then _root_real="$PWD"; fi
  if [ -n "${HOME:-}" ] && cd -P "$HOME" 2>/dev/null; then _home_real="$PWD"; fi
  cd "$_back" 2>/dev/null || true
  [ -n "$_root_real" ] || return 1
  [ "$_root_real" != "$_home_real" ]
}

# df_no_symlink_below <root> <path>... — returns 0 when no <path>, and no folder
# between <root> and it, is a symbolic link. Returns 1 when one is, and for any
# call it cannot vouch for: no <path>, an empty <root>, a <path> not below <root>,
# or a <path> with an empty, `.` or `..` part or more than 64 parts below <root>.
# A predicate: call it in an `if` or an `||` list, never as a plain statement
# under `set -e`.
#
# D-HOOKS-NO-SYMLINK: a hook writes under a project's `.devflow/`, and reads a file
# there into the session context, a backup, a prompt or an agent directive, only
# where nothing on the way down from the root is a symbolic link. A repository can
# commit a link anywhere in its own `.devflow/`, and the hooks' shell commands follow
# one. `>>` and `touch` write through a linked file and `mkdir -p` creates folders
# inside a linked folder, so a linked queue or folder would put captured
# conversation text into whatever file the link names. `head`, `sed`, `read` and
# `jq` read through one, so a linked working memory, backup or decisions file would
# put whatever file the link names into the session, the memory refresh's prompt or
# the backup the next session restores, with no one choosing to read it. Each hook
# checks every path this rule covers: a refused write is skipped and a refused
# read is treated as an absent file (df_file_below below), each logged once. A
# rename's target is one of those paths: `mv` moves a file into the folder a link
# at its target names, so a link there, to anything, refuses the rename.
#
# Only the part of each path below <root> is checked, never the root or a folder
# above it: the root is where the session runs or where git keeps the ledger,
# chosen by the user and not by what the repository holds, and a folder above it
# may legitimately be a link (on macOS /tmp and /var lead into /private). The check
# runs just before the write or the read, so a process that swaps a link in between
# is not stopped; such a process already runs as the user.
#
# Zero forks: builtin `[ -L ]` tests and parameter expansion only.
df_no_symlink_below() {
  local _root="$1" _path="" _rest="" _seg="" _at="" _n=0
  [ -n "$_root" ] || return 1
  shift
  [ "$#" -gt 0 ] || return 1
  for _path in "$@"; do
    case "$_path" in
      "$_root"/?*) _rest="${_path#"$_root"/}" ;;
      *) return 1 ;;
    esac
    _at="$_root"
    _n=0
    while [ -n "$_rest" ]; do
      [ "$_n" -lt 64 ] || return 1
      _seg="${_rest%%/*}"
      if [ "$_seg" = "$_rest" ]; then _rest=""; else _rest="${_rest#*/}"; fi
      case "$_seg" in ''|.|..) return 1 ;; esac
      _at="$_at/$_seg"
      if [ -L "$_at" ]; then return 1; fi
      _n=$((_n + 1))
    done
  done
  return 0
}

# df_file_below <root> <path> — returns 0 when <path> is a regular file that
# df_no_symlink_below admits, so a hook may read it. Returns 1 when no regular file
# stands there, and when a symbolic link sits on its path: the file is then treated
# as absent (D-HOOKS-NO-SYMLINK, above), and that refusal is logged once through the
# caller's log(), where it defines one. `[ -f ]` follows a link, so a dangling link
# or a link to a folder reads as absent with nothing logged: nothing would be read
# through it. A predicate, like df_no_symlink_below; it forks nothing unless it logs.
df_file_below() {
  [ -f "$2" ] || return 1
  if df_no_symlink_below "$1" "$2"; then return 0; fi
  if declare -F log >/dev/null 2>&1; then
    log "Skipped: a symbolic link sits on the path to $2; treated as absent"
  fi
  return 1
}

# df_ledger_folder <devflow_dir> <old> [<new>] — sets DF_LEDGER_FOLDER to the path of
# the ledger folder a creator may create or write into: <devflow_dir>/<old> while that
# name is present (a folder, a file or a link, dangling or not), else
# <devflow_dir>/<new>. <new> defaults to <old>, so a caller that names only the old
# folder gets the old folder's path in every state.
#
# The creator rule: a creator makes the new folder only when the old name is absent.
# A new folder made beside a present old one would hide the old ledger from every
# reader, so the session-start heal, the ensure-devflow-init scaffold and queue
# append all take their folder from here. It answers a path and creates nothing; the
# caller checks the path with df_no_symlink_below and creates it.
#
# Zero forks: builtin tests and parameter expansion only. It always returns 0; read
# the answer from DF_LEDGER_FOLDER, not from a command substitution.
df_ledger_folder() {
  local _dir="$1" _old="$2" _new="${3:-$2}"
  if [ -e "$_dir/$_old" ] || [ -L "$_dir/$_old" ]; then
    DF_LEDGER_FOLDER="$_dir/$_old"
  else
    DF_LEDGER_FOLDER="$_dir/$_new"
  fi
  return 0
}

# df_ledger_queue <queue_file> <old> [<new>] — sets DF_LEDGER_QUEUE to the queue file
# a creator may append to. A queue file whose folder is named <old> or <new> is
# answered under the folder df_ledger_folder picks for that folder's parent; a queue
# in any other folder (the memory queue) and a path with fewer than two parts come
# back unchanged. <new> defaults to <old>. Creates nothing; zero forks; returns 0.
df_ledger_queue() {
  local _file="$1" _old="$2" _new="${3:-$2}" _folder="" _parent="" _name=""
  DF_LEDGER_QUEUE="$_file"
  case "$_file" in */*/*) ;; *) return 0 ;; esac
  _folder="${_file%/*}"
  _parent="${_folder%/*}"
  _name="${_folder##*/}"
  case "$_name" in
    "$_old"|"$_new")
      df_ledger_folder "$_parent" "$_old" "$_new"
      DF_LEDGER_QUEUE="$DF_LEDGER_FOLDER/${_file##*/}"
      ;;
  esac
  return 0
}

# df_make_ledger_folder <root> <devflow_dir> <old> <new> — the one creator of the
# ledger folder for a hook. It sets DF_LEDGER_FOLDER as df_ledger_folder does, then
# makes the NEW folder and only the new one, and only where the old name is absent at
# the probe and no link sits on the way down from <root> (df_no_symlink_below). Where
# the old name is present it makes nothing, so a creator never makes the old folder:
# a `mkdir -p` on it would bring back an empty old folder beside the new one after a
# move had renamed it away. It logs nothing, so each hook words its own skip once.
# A predicate: it returns 0 when nothing is left to make or the folder was made, 2 for
# a link on the path (nothing is made), and 1 for an empty argument or a failed mkdir.
# Call it in an `if` or an `||` list, never as a plain statement under `set -e`.
#
# The remaining window is the gap between the probe and the mkdir. A move that
# finishes inside it leaves no folder this time, and the next event makes the new one.
# An old folder that appears inside it, from an older install or by hand, leaves the
# new folder beside it, and the next move merges the two. No data is lost either way:
# the helper only ever makes an empty folder, and never writes into or removes one.
df_make_ledger_folder() {
  local _root="$1" _dir="$2" _old="$3" _new="$4"
  [ -n "$_root" ] && [ -n "$_dir" ] && [ -n "$_old" ] && [ -n "$_new" ] || return 1
  df_ledger_folder "$_dir" "$_old" "$_new"
  [ "$DF_LEDGER_FOLDER" = "$_dir/$_new" ] || return 0
  if ! df_no_symlink_below "$_root" "$DF_LEDGER_FOLDER"; then return 2; fi
  if [ -d "$DF_LEDGER_FOLDER" ]; then return 0; fi
  mkdir -p "$DF_LEDGER_FOLDER" 2>/dev/null || return 1
  return 0
}

# df_global_tuning_file <machine_dir> — sets DF_GLOBAL_TUNING_FILE to the global
# curate-agent tuning file inside the machine directory (~/.devflow). The shell
# twin of getGlobalCurateTuningConfigPath in src/core/project-paths.ts: the one
# place a hook names the file. Zero forks; returns 0.
df_global_tuning_file() {
  DF_GLOBAL_TUNING_FILE="$1/curation.json"
  return 0
}
