#!/bin/bash
# Sourced helper: df_has_git_marker <dir> — returns 0 if <dir> or any of its
# ancestors (bounded, max 64 levels) contains a .git entry (dir or file).
# Pure bash, no subprocess — safe for the per-prompt UserPromptSubmit hot path.
# The -e test covers both .git directories and worktree/submodule .git files.
df_has_git_marker() {
  local _dir="$1" _i=0
  while [ "$_i" -lt 64 ]; do
    [ -e "$_dir/.git" ] && return 0
    if [ "$_dir" = "/" ] || [ -z "$_dir" ]; then return 1; fi
    _dir="${_dir%/*}"
    [ -z "$_dir" ] && _dir="/"
    _i=$((_i + 1))
  done
  return 1
}

# df_is_project_root <root> — returns 0 when <root> may hold per-project devflow
# data: it is a checkout's toplevel — it holds its own `.git` entry — AND it is not
# the home directory.
#
# D-HOOKS-GIT-ONLY: the hooks that scaffold `.devflow/` and the root `.gitignore`
# carve-out — session-start-context and ensure-devflow-init, which every capture
# and memory hook reaches — run only for a git project. Outside one there is no
# repository for the carve-out to protect and no branch for memory to describe,
# and scaffolding there would leave `.devflow/` and a `.gitignore` block in `~`,
# Downloads or a folder of repos — wherever Claude Code happened to start.
# A repository rooted at HOME (a dotfiles repo) is refused too: its `.devflow` IS
# the machine root, so per-project data would land inside `~/.devflow` and its
# carve-out in the user's home `.gitignore`.
#
# D-HOOKS-TOPLEVEL-ONLY: the `.git` entry must sit AT <root>, not merely above it.
# Callers pass the root df_resolve_roots resolved, and when `git rev-parse` fails
# from inside a checkout — the repository has dubious ownership, or
# GIT_CEILING_DIRECTORIES stops git's search — that root is the raw cwd, possibly a
# subdirectory. An ancestor walk would still find the checkout's `.git` and admit
# it, and `.devflow/` plus a `.gitignore` block would land in that subdirectory.
# Requiring the marker at the root makes the gate and the resolver agree: git's
# toplevel always holds `.git` (a directory, or the file a linked worktree or
# submodule carries), a subdirectory never does. A directory that holds its own
# `.git` still passes when git cannot read it — the marker contract is the zero-fork
# one above, and writing there scatters nothing, because it is the checkout's root.
#
# The comparison is between PHYSICAL paths, because the two sides reach it by
# different routes: git reports a toplevel with every symlink resolved, while
# $HOME is whatever the login shell was handed — on macOS the temp tree is
# /var → /private/var, and a home directory can itself sit behind a symlink. A
# textual compare would miss exactly the case it exists for.
#
# Zero forks, like the marker walk above: a builtin `-e` test, then `cd -P`, which
# resolves a path physically and publishes it in $PWD — both shell builtins, so no
# `$(...)` subshell and no realpath/readlink binary is involved. The caller's directory is restored before
# returning. An unresolvable <root> is refused (fail closed: nothing is written);
# an unset or unresolvable HOME cannot equal a resolved root, so it refuses nothing.
df_is_project_root() {
  local _root="$1" _back="$PWD" _root_real="" _home_real=""
  [ -n "$_root" ] || return 1
  [ -e "$_root/.git" ] || return 1
  if cd -P "$_root" 2>/dev/null; then _root_real="$PWD"; fi
  if [ -n "${HOME:-}" ] && cd -P "$HOME" 2>/dev/null; then _home_real="$PWD"; fi
  cd "$_back" 2>/dev/null || true
  [ -n "$_root_real" ] || return 1
  [ "$_root_real" != "$_home_real" ]
}

# df_no_symlink_below <root> <path>... — returns 0 when no <path>, and no folder
# between <root> and it, is a symbolic link. Returns 1 when one is, and for any
# call it cannot vouch for: no <path>, an empty <root>, a <path> not below <root>,
# or a <path> with an empty, `.` or `..` part or more than 64 parts below <root>.
# A predicate: call it in an `if` or an `||` list, never as a plain statement
# under `set -e`.
#
# D-HOOKS-NO-SYMLINK-WRITE: a hook writes under a project's `.devflow/` only where
# nothing on the way down from the root is a symbolic link. A repository can commit
# a link anywhere in its own `.devflow/`, and the hooks' writes follow one: `>>`
# and `touch` write through a linked file, and `mkdir -p` creates folders inside a
# linked folder, so a linked queue or folder would put captured conversation text
# into whatever file the link names. Each hook checks the paths it writes in place
# and skips the write, logging it once, when this refuses. A copy renamed into
# place needs only its folder checked: a rename replaces a link at its target
# instead of following it, and the copy is created only where nothing stands
# (noclobber).
#
# Only the part of each path below <root> is checked, never the root or a folder
# above it: the root is where the session runs or where git keeps the ledger,
# chosen by the user and not by what the repository holds, and a folder above it
# may legitimately be a link (on macOS /tmp and /var lead into /private). The check
# runs just before the write, so a process that swaps a link in between is not
# stopped; such a process already writes as the user.
#
# Zero forks: builtin `[ -L ]` tests and parameter expansion only.
df_no_symlink_below() {
  local _root="$1" _path="" _rest="" _seg="" _at="" _n=0
  [ -n "$_root" ] || return 1
  shift
  [ "$#" -gt 0 ] || return 1
  for _path in "$@"; do
    case "$_path" in
      "$_root"/?*) _rest="${_path#"$_root"/}" ;;
      *) return 1 ;;
    esac
    _at="$_root"
    _n=0
    while [ -n "$_rest" ]; do
      [ "$_n" -lt 64 ] || return 1
      _seg="${_rest%%/*}"
      if [ "$_seg" = "$_rest" ]; then _rest=""; else _rest="${_rest#*/}"; fi
      case "$_seg" in ''|.|..) return 1 ;; esac
      _at="$_at/$_seg"
      if [ -L "$_at" ]; then return 1; fi
      _n=$((_n + 1))
    done
  done
  return 0
}
