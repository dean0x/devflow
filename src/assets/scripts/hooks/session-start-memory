#!/bin/bash

# SessionStart Hook
# Injects working memory as additionalContext.
# Memory: restores .devflow/memory/WORKING-MEMORY.md with git-reconciled header
# and 3-state rendering (in-sync / drifted / refresh-failing).
# State detection uses the <!-- memory-head: <sha> branch: <name> --> stamp on line 1.
# No raw UNPROCESSED TURNS dump — the background-memory-update worker handles refresh.

# Safe no-op fallback: must exist before set -e and before hook-bootstrap is sourced.
dbg() { :; }

set -e

# Re-entrancy guard — before hook-bootstrap to minimize background session
# overhead. The memory worker's own claude -p session fires SessionStart hooks
# too (SessionStart fires on every session, including a detached worker's).
if [ "${DEVFLOW_BG_UPDATER:-}" = "1" ]; then dbg "EXIT: bg_updater"; exit 0; fi

# JSON parsing (jq with node fallback) — silently no-op if neither available
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

source "$SCRIPT_DIR/hook-bootstrap" "session-start-memory"

source "$SCRIPT_DIR/json-parse" || { echo "session-start-memory: failed to source json-parse" >&2; exit 1; }
if [ "$_JSON_AVAILABLE" = "false" ]; then exit 0; fi

INPUT=$(cat)

CWD=$(printf '%s' "$INPUT" | json_field "cwd" "")
if [ -z "$CWD" ] || [ ! -d "$CWD" ]; then
  dbg "EXIT: bad CWD"
  exit 0
fi

devflow_debug_set_cwd "$CWD"
dbg "CWD=$CWD"

# Anchor .devflow/ to the project root (prevents a stray nested .devflow/ when this
# hook runs with a CWD inside .devflow/...). Empty → fall back to CWD.
source "$SCRIPT_DIR/resolve-project-root" 2>/dev/null || true
# Note limits, stamps and worker notices. Notices need df_file_below from resolve-project-root.
source "$SCRIPT_DIR/memory-permission" || { echo "session-start-memory: failed to source memory-permission" >&2; exit 1; }
PROJECT_ROOT="$(df_resolve_root "$CWD" 2>/dev/null || true)"
[ -n "$PROJECT_ROOT" ] || PROJECT_ROOT="$CWD"

# The machine-wide manifest (the memory switch, D-FEATURES-NARROW-ONLY in
# queue-append) lives at the machine root,
# $HOME/.devflow (D-ONE-HOME).
DEVFLOW_MANIFEST="$HOME/.devflow/manifest.json"
PROJECT_DEVFLOW_DIR="$PROJECT_ROOT/.devflow"
MEMORY_DIR="$PROJECT_DEVFLOW_DIR/memory"

# Normal logging
source "$SCRIPT_DIR/hook-log-init" "session-start-memory"

# Memory gate: the machine switch, narrowed by this checkout's project.json /
# config.json `features.memory`, read by the helper every memory/curation gate
# shares (D-FEATURES-NARROW-ONLY, see queue-append).
source "$SCRIPT_DIR/queue-append" || { echo "session-start-memory: failed to source queue-append" >&2; exit 1; }
queue_read_gates "$DEVFLOW_MANIFEST" "$PROJECT_ROOT"
if [ "$_QG_MEMORY" != "true" ]; then
  dbg "EXIT: memory disabled"
  exit 0
fi

# --- Memory area check ---
# A folder that git tracks holds the repository's content, not devflow's data. While git
# tracks files in the memory folder of this checkout, or a `.git` entry stands and git does
# not answer, the memory area is paused: this hook moves no batch, reads no working memory,
# no refresh warning, no queue and no worker notice, and the worker notice stays where it is.
# The check asks once, in node mode, so a git that hangs is cut (queue_tracked_area), and
# asks at the project root this hook resolved, not at the ledger root.
# One fixed notice goes to the user as a systemMessage, on a session that starts, resumes
# or is cleared; a compaction sends nothing. It is not model context. Each arm is a constant:
# a single-quoted string that interpolates nothing, so no repository content reaches the
# user through it. Its words are AREA_PAUSE_NOTICE.memory in src/core/area-pause-notice.ts
# (tests/shell-hooks.test.ts holds the two equal).
queue_tracked_area "$PROJECT_ROOT" memory node
if [ "${DF_TRACKED_AREA_MEMORY:-unknown}" != "untracked" ]; then
  _SSM_PAUSE_REASON="unknown"
  if [ "${DF_TRACKED_AREA_MEMORY:-}" = "tracked" ]; then _SSM_PAUSE_REASON="tracked"; fi
  log "Memory paused: git tracks files in the memory folder, or did not answer (${_SSM_PAUSE_REASON}); nothing read or written"
  AREA_PAUSE_MESSAGE=""
  case "$_SSM_PAUSE_REASON" in
    tracked)
      AREA_PAUSE_MESSAGE='Devflow memory is paused for this checkout, because git tracks files in the memory folder. Devflow reads and writes nothing there while git tracks files there. To find the files, run `git ls-files .devflow`. Untrack them with `git rm --cached <file>`, then delete them if you did not make them. Run these commands in this checkout.'
      ;;
    unknown)
      AREA_PAUSE_MESSAGE='Devflow memory is paused for this checkout, because git did not answer whether it tracks files in the memory folder. Devflow reads and writes nothing there until git answers. The check runs again at the next session start. If this notice stays, check that git runs in this checkout.'
      ;;
  esac
  CONTEXT=""
  SYSTEM_MESSAGE=""
  case "$(printf '%s' "$INPUT" | json_field "source" "")" in
    startup|resume|clear)
      SYSTEM_MESSAGE="$AREA_PAUSE_MESSAGE"
      dbg "memory pause notice emitted"
      json_session_output "$CONTEXT" "$SYSTEM_MESSAGE"
      ;;
  esac
  dbg "EXIT: memory area paused"
  exit 0
fi

# Refuse a linked parent once, before recovery or any memory read.
if ! df_no_symlink_below "$PROJECT_ROOT" "$MEMORY_DIR"; then
  log "Skipped: a symbolic link sits on the path to the memory folder"
  exit 0
fi

# --- D56c cold-path recovery: orphaned .pending-turns.processing ---
# The worker owns recovery. SessionStart moves a stale batch to an empty queue
# under the same queue lock. A batch beside a claimed queue or merge copy still
# needs the worker. If only the merge copy remains, it holds the complete batch.
source "$SCRIPT_DIR/get-mtime" || { echo "session-start-memory: failed to source get-mtime" >&2; exit 1; }
source "$SCRIPT_DIR/is-hex-sha" || { echo "session-start-memory: failed to source is-hex-sha" >&2; exit 1; }
source "$SCRIPT_DIR/curation-lock" || { echo "session-start-memory: failed to source curation-lock" >&2; exit 1; }
_SSM_PT_PROC="$MEMORY_DIR/.pending-turns.processing"
_SSM_PT_JSONL="$MEMORY_DIR/.pending-turns.jsonl"
_SSM_PT_CLAIMED="$_SSM_PT_PROC.claimed"
_SSM_PT_MERGE="$_SSM_PT_PROC.merge"
_SSM_PT_LOCK="$_SSM_PT_JSONL.lock"
_SSM_REFUSED_PATH=""

recover_stale_memory_batch() {
  local _batch="$_SSM_PT_PROC" _mtime _age _path
  if ! path_occupied "$_SSM_PT_PROC"; then _batch="$_SSM_PT_MERGE"; fi
  if ! df_file_below "$PROJECT_ROOT" "$_batch"; then
    _SSM_REFUSED_PATH="$_batch"
    return 0
  fi
  _mtime=$(get_mtime "$_batch" 2>/dev/null) || return 0
  _age=$(( $(date +%s) - ${_mtime:-0} ))
  [ "$_age" -gt 300 ] || return 0
  for _path in "$_SSM_PT_JSONL" "$_SSM_PT_CLAIMED" "$_SSM_PT_MERGE"; do
    if ! df_no_symlink_below "$PROJECT_ROOT" "$_path"; then
      log "Stale .pending-turns.processing skipped (cold path): a symbolic link sits on the path to $_path"
      _SSM_REFUSED_PATH="$_path"
      return 0
    fi
  done
  if path_occupied "$_SSM_PT_JSONL"; then
    log "Stale .pending-turns.processing skipped (cold path): .pending-turns.jsonl already exists"
    return 0
  fi
  if [ "$_batch" = "$_SSM_PT_PROC" ]; then
    if path_occupied "$_SSM_PT_CLAIMED" || path_occupied "$_SSM_PT_MERGE"; then return 0; fi
  else
    rm -f "$_SSM_PT_CLAIMED" 2>/dev/null || return 0
  fi
  if mv -n "$_batch" "$_SSM_PT_JSONL" 2>/dev/null && ! path_occupied "$_batch"; then
    dbg "Recovered orphaned .pending-turns.processing (age ${_age}s)"
    log "Recovered orphaned .pending-turns.processing → .pending-turns.jsonl (cold path)"
  fi
  return 0
}

if { [ -f "$_SSM_PT_PROC" ] || [ -f "$_SSM_PT_MERGE" ]; } \
    && df_no_symlink_below "$PROJECT_ROOT" "$_SSM_PT_LOCK" \
    && curation_lock_acquire "$_SSM_PT_LOCK" 1; then
  recover_stale_memory_batch
  curation_lock_release "$_SSM_PT_LOCK"
fi

CONTEXT=""

# --- Section 1: Working Memory with git-reconciled header ---

MEMORY_FILE="$MEMORY_DIR/WORKING-MEMORY.md"

# Count the bytes from one bounded read. Keep final newlines with a suffix.
# An end of file gives the full text. A null byte ends read early, so refuse it.
read_bounded_memory_note() {
  local LC_ALL=C _text
  MEMORY_NOTE_BYTES="unknown"
  MEMORY_CONTENT=""
  [ -f "$1" ] && [ ! -L "$1" ] || return 1
  _text=$(
    set -o pipefail
    head -c "$((MEMORY_NOTE_CAP_BYTES + 1))" "$1" 2>/dev/null | {
      if IFS= read -r -d '' _note; then exit 1; fi
      printf '%s.' "$_note"
    }
  ) || return 1
  MEMORY_CONTENT="${_text%.}"
  MEMORY_NOTE_BYTES="${#MEMORY_CONTENT}"
  [ "$MEMORY_NOTE_BYTES" -le "$MEMORY_NOTE_CAP_BYTES" ]
}

# --- detect_refresh_failing <now> <memory_dir> <log_dir> <root>: sets
# REFRESH_FAILING in caller's scope. <root> is the project root the memory folder
# lies below.
# Condition: queue non-empty AND (.last-refresh-ok missing OR >600s old)
# orphaned-processing depth fix: count both .pending-turns.jsonl AND
# .pending-turns.processing toward _queue_depth. Before this fix, an orphaned
# .processing (whose mtime is between 0s and the D56c 300s cold-path gate)
# was invisible to State-C — a crashed worker's batch would sit silently with
# no user-visible warning. The count reaches the session, so a batch a symbolic
# link leads to counts as absent (D-HOOKS-NO-SYMLINK, git-marker).
detect_refresh_failing() {
  local _now="$1"
  local _memory_dir="$2"
  local _log_dir="$3"
  local _root="$4"
  local _queue_file="$_memory_dir/.pending-turns.jsonl"
  local _proc_file="$_memory_dir/.pending-turns.processing"
  local _ok_file="$_memory_dir/.last-refresh-ok"
  local _queue_depth=0
  # Recovery already refused this path. Do not check it or log its refusal again.
  if [ "$_queue_file" != "$_SSM_REFUSED_PATH" ] && df_file_below "$_root" "$_queue_file" && [ -s "$_queue_file" ]; then
    _queue_depth=$(wc -l < "$_queue_file" | tr -d ' ')
  fi
  # Also count lines in .processing — an orphaned batch left by a crashed worker
  # is unprocessed content even if .jsonl is empty (applies B4 blind-spot fix)
  if [ "$_proc_file" != "$_SSM_REFUSED_PATH" ] && df_file_below "$_root" "$_proc_file" && [ -s "$_proc_file" ]; then
    local _proc_depth
    _proc_depth=$(wc -l < "$_proc_file" | tr -d ' ')
    _queue_depth=$(( _queue_depth + _proc_depth ))
  fi
  local _ok_age=9999999
  if [ -f "$_ok_file" ]; then
    local _ok_mtime
    _ok_mtime=$(get_mtime "$_ok_file")
    _ok_age=$(( _now - _ok_mtime ))
  fi
  REFRESH_FAILING=""
  if [ "$_queue_depth" -gt 0 ] && { [ ! -f "$_ok_file" ] || [ "$_ok_age" -gt 600 ]; }; then
    local _ok_min=$(( _ok_age / 60 ))
    local _ok_min_str
    if [ "$_ok_age" -ge 9999999 ]; then
      _ok_min_str="never"
    else
      _ok_min_str="${_ok_min}m"
    fi
    REFRESH_FAILING="⚠ MEMORY REFRESH MAY BE FAILING — ${_queue_depth} turn(s) unprocessed, last refresh ${_ok_min_str} ago; check ${_log_dir}/.background-memory-update.log"
    dbg "State C: refresh failing (QUEUE_DEPTH=$_queue_depth OK_AGE=${_ok_age}s)"
  fi
}

render_memory_context() {
  FILE_MTIME=$(get_mtime "$MEMORY_FILE")
  AGE_SEC=$(( NOW - FILE_MTIME ))
  AGE_MIN=$(( AGE_SEC / 60 ))
  dbg "MEMORY_FILE AGE=${AGE_SEC}s"

  FIRST_LINE=${MEMORY_CONTENT%%$'\n'*}
  MEMORY_BODY="$MEMORY_CONTENT"
  memory_stamp_parse "$FIRST_LINE"
  case "$FIRST_LINE" in
    '<!-- memory-head:'*)
      MEMORY_BODY=""
      case "$MEMORY_CONTENT" in
        *$'\n'*) MEMORY_BODY=${MEMORY_CONTENT#*$'\n'} ;;
      esac
      if [ -z "$STAMP_SHA" ] || [ -z "$STAMP_BRANCH" ] ||
          { [[ "$FIRST_LINE" == *' multi: '* ]] && [ -z "$STAMP_MULTI" ]; } ||
          { [[ "$FIRST_LINE" == *' session: '* ]] && [ -z "$STAMP_SESSION" ]; }; then
        dbg "Memory stamp has a field that did not pass the format check"
      fi
      ;;
  esac
  if [ -z "$STAMP_SHA" ]; then STAMP_BRANCH=""; fi

  MULTI_LABEL=""
  MULTI_ADVICE=""
  if [ -n "$STAMP_MULTI" ] && [ -n "$(memory_multi_epoch_from_line "$FIRST_LINE" "$NOW")" ]; then
    MULTI_LABEL="; more than one session"
    MULTI_ADVICE='Confirm the task with the user. Use one worktree for each parallel session.
'
  fi

  # --- Gather current git state ---
  BRANCH=""
  HEAD=""
  if cd "$CWD" 2>/dev/null && git rev-parse --git-dir >/dev/null 2>&1; then
    BRANCH=$(git branch --show-current 2>/dev/null || echo "")
    HEAD=$(git rev-parse HEAD 2>/dev/null || echo "")
  fi
  _BRANCH_LABEL="$BRANCH"
  if [ -n "$BRANCH" ] && ! _memory_stamp_branch_valid "$BRANCH"; then
    _BRANCH_LABEL="unknown"
    BRANCH=""
  fi
  dbg "BRANCH=$BRANCH HEAD=$HEAD"

  # --- Compute drift (only when stamp SHA is provably an ancestor of HEAD) ---
  # Single rev-walk: capture full git log output once, then derive count + display lines
  # from the same data — avoids walking the same commit range twice (perf fix).
  COMMITS=0
  _DRIFT_LOG=""
  if [ -n "$STAMP_SHA" ] && [ -n "$HEAD" ] && [ "$STAMP_SHA" != "$HEAD" ]; then
    # git merge-base --is-ancestor exits 0 when $STAMP_SHA is ancestor of HEAD
    if cd "$CWD" 2>/dev/null && git merge-base --is-ancestor "$STAMP_SHA" "$HEAD" 2>/dev/null; then
      _DRIFT_LOG_FULL=$(git log --oneline "${STAMP_SHA}..${HEAD}" 2>/dev/null || echo "")
      # grep -c exits 1 on zero matches (POSIX); || true prevents set -e abort.
      # ${COMMITS:-0} defends the transient-failure case where grep emits nothing.
      # The old `|| echo "0"` produced "0\n0" (a two-line string) because grep -c
      # already printed "0" before exiting 1, causing [ "$COMMITS" -le 0 ] to fail
      # with "integer expression expected" and misroute State A into State B.
      COMMITS=$(printf '%s\n' "$_DRIFT_LOG_FULL" | grep -c . 2>/dev/null || true)
      COMMITS=${COMMITS:-0}
      _DRIFT_LOG=$(printf '%s\n' "$_DRIFT_LOG_FULL" | head -10)
    fi
  fi
  dbg "COMMITS=$COMMITS"

  # --- Branch mismatch warning (shown for any state) ---
  # A `(detached)` stamp (pre-compact-memory's D-DETACHED-HEAD bootstrap) names no
  # branch, so it is worded as the state it is rather than as a branch called that.
  BRANCH_MISMATCH_NOTE=""
  if [ -n "$STAMP_BRANCH" ] && [ -n "$BRANCH" ] && [ "$STAMP_BRANCH" != "$BRANCH" ]; then
    if [ "$STAMP_BRANCH" = "(detached)" ]; then
      BRANCH_MISMATCH_NOTE="⚠ Memory was written on a detached HEAD; you are now on ${BRANCH}.
"
    else
      BRANCH_MISMATCH_NOTE="⚠ Memory was written on branch ${STAMP_BRANCH}; you are now on ${BRANCH}.
"
    fi
  fi

  # --- Build state-specific header ---
  # D-DETACHED-HEAD: where the session is, as one phrase. On a branch it is
  # `on <branch>`; on a detached HEAD — a commit checked out rather than a branch,
  # for which `git branch --show-current` prints nothing — it is
  # `detached @ <short-sha>`, naming the commit instead of rendering "unknown" as if
  # the state could not be read. HEAD passes the same hex gate the stamp does before
  # it is sliced into the header. Only an unreadable state is `on unknown`.
  _STAMP_LABEL="${STAMP_SHA:-unknown}"
  if [ -n "$_BRANCH_LABEL" ]; then
    _WHERE_LABEL="on ${_BRANCH_LABEL}"
  elif [ -n "$HEAD" ] && is_hex_sha "$HEAD"; then
    _WHERE_LABEL="detached @ ${HEAD:0:7}"
  else
    _WHERE_LABEL="on unknown"
  fi

  if [ "$COMMITS" -le 0 ]; then
    MEMORY_HEADER="--- WORKING MEMORY (synced @ ${_STAMP_LABEL} ${_WHERE_LABEL}, ${AGE_MIN}m ago${MULTI_LABEL}) ---"
    dbg "State A: in-sync or no stamp"
  else
    MEMORY_HEADER="--- WORKING MEMORY (${COMMITS} commit(s) ago @ ${_STAMP_LABEL} ${_WHERE_LABEL}, ${AGE_MIN}m ago — ⚠ reconcile${MULTI_LABEL}) ---
Commits since memory was written:
${_DRIFT_LOG}"
    dbg "State B: drifted COMMITS=$COMMITS"
  fi

  CONTEXT="${BRANCH_MISMATCH_NOTE}${MEMORY_HEADER}
${MULTI_ADVICE}${MEMORY_BODY}"
}

# D-HOOKS-NO-SYMLINK (git-marker): read the note only at a regular, unlinked path.
MEMORY_PRESENT=""
if df_file_below "$PROJECT_ROOT" "$MEMORY_FILE"; then MEMORY_PRESENT="yes"; fi

if [ -n "$MEMORY_PRESENT" ]; then
  NOTE_LOADED="false"
  if read_bounded_memory_note "$MEMORY_FILE"; then NOTE_LOADED="true"; fi
  NOW=$(date +%s)
  if [ "$NOTE_LOADED" = "true" ]; then
    render_memory_context
  else
    _cap="${MEMORY_NOTE_CAP_BYTES:0:${#MEMORY_NOTE_CAP_BYTES}-3},${MEMORY_NOTE_CAP_BYTES: -3}"
    CONTEXT="Working memory not loaded: over the ${_cap}-byte cap; the next update rewrites it."
    log "Working memory not loaded (bytes=$MEMORY_NOTE_BYTES)"
  fi

  detect_refresh_failing "$NOW" "$MEMORY_DIR" "$LOG_DIR" "$PROJECT_ROOT"
  # Show the refresh banner even if the note was not loaded.
  if [ -n "$REFRESH_FAILING" ]; then
    CONTEXT="${CONTEXT}

${REFRESH_FAILING}"
    dbg "State C appended"
  fi
else
  dbg "MEMORY_FILE not found: $MEMORY_FILE"
fi

# --- One-time worker notice ---
# When the memory worker cannot refresh memory for a reason only the user can fix (a
# project path its permission rule cannot carry, the worker's write refused in two runs
# with no successful update between them), it leaves a notice file. The message is shown
# to the user once per reason, whether or not a working memory exists, and the file moves
# to its `.shown` marker so the next start stays quiet (memory-permission). The worker log
# is `.background-memory-update.log` under ~/.devflow/logs/, in the folder for the session
# that ran the worker; the message names this session's folder for it.
# D-SYSTEMMESSAGE-ENVELOPE: it travels as `systemMessage`, beside the context and never in it.
memory_notice_read "$MEMORY_DIR" "$PROJECT_ROOT" "$LOG_DIR/.background-memory-update.log"
SYSTEM_MESSAGE="$MEMORY_NOTICE_MESSAGE"
if [ -n "$SYSTEM_MESSAGE" ]; then
  dbg "Worker notice shown"
  log "Worker notice shown to the user"
fi

# --- Output ---

# Only output if we have something to inject or to tell the user
if [ -z "$CONTEXT" ] && [ -z "$SYSTEM_MESSAGE" ]; then
  dbg "EXIT: no context to inject"
  exit 0
fi

dbg "OUTPUT_LENGTH=${#CONTEXT}"
if [ -n "$CONTEXT" ]; then
  log "Injecting memory context (${#CONTEXT} chars)"
fi
dbg "=== HOOK COMPLETE ==="

# Output as additionalContext JSON envelope (Claude sees it as system context, not user-visible);
# a notice adds a systemMessage the user sees.
json_session_output "$CONTEXT" "$SYSTEM_MESSAGE"
