@import "./_settings.mds" as settings

@define compliance_gate():
**Resolve `COMPLIANCE_SKILL_INSTALLED` once per run:** Check whether `~/.claude/skills/devflow:compliance/SKILL.md` exists (one file-existence check, read-only, silent). Set `COMPLIANCE_SKILL_INSTALLED = true` if the file exists, `false` otherwise.

{{settings.settings_resolve()}}

Set `COMPLIANCE` from the settings line: `off`, `generic`, or the framework ids the machine and this repository declare.
@end

@export compliance_gate
