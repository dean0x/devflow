{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "rootDir": ".",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": [
    "scripts/**/*.ts",
    "tests/build-mds.test.ts",
    "tests/build-mds-compile-time.test.ts",
    "tests/token-audit.test.ts",
    "tests/core/curation-store-error-kind.test.ts",
    "tests/integration/helpers.ts",
    "tests/integration/helpers.test.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
